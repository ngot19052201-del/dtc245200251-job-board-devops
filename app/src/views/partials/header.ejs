<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'JobBoard - Website Tuyển Dụng Việc Làm' %></title>
  
  <!-- SEO Meta -->
  <meta name="description" content="Hệ thống tuyển dụng việc làm công nghệ cao trực tuyến - Đề tài bài tập lớn của sinh viên Trương Thị Bích Ngọc DTC245200251.">
  <meta name="author" content="Trương Thị Bích Ngọc - DTC245200251 - ICTU">

  <!-- Google Fonts & Bootstrap Icons & Bootstrap 5.3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('navbar') %>
  
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="container mt-3">
      <div class="alert alert-<%= flash.type %> alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi <%= flash.type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %> me-2"></i>
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  <% } %>
