<%- include('../partials/header') %>

<div class="bg-primary text-white py-4 mb-4">
  <div class="container">
    <h1 class="h3 fw-bold mb-1">Chỉnh Sửa Tin Tuyển Dụng</h1>
    <p class="mb-0 text-light opacity-90"><%= job.title %></p>
  </div>
</div>

<div class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <form action="/recruiter/edit-job/<%= job.id %>" method="POST">
          
          <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề tin tuyển dụng <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" value="<%= job.title %>" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Ngành nghề / Danh mục <span class="text-danger">*</span></label>
              <select name="category_id" class="form-select" required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= job.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Hình thức làm việc <span class="text-danger">*</span></label>
              <select name="job_type" class="form-select" required>
                <option value="Toàn thời gian" <%= job.job_type === 'Toàn thời gian' ? 'selected' : '' %>>Toàn thời gian</option>
                <option value="Bán thời gian" <%= job.job_type === 'Bán thời gian' ? 'selected' : '' %>>Bán thời gian</option>
                <option value="Remote" <%= job.job_type === 'Remote' ? 'selected' : '' %>>Remote</option>
                <option value="Thực tập" <%= job.job_type === 'Thực tập' ? 'selected' : '' %>>Thực tập</option>
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">Mức lương <span class="text-danger">*</span></label>
              <input type="text" name="salary_range" class="form-control" value="<%= job.salary_range %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Địa điểm <span class="text-danger">*</span></label>
              <input type="text" name="location" class="form-control" value="<%= job.location %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Trạng thái tin</label>
              <select name="status" class="form-select">
                <option value="approved" <%= job.status === 'approved' ? 'selected' : '' %>>Đang mở tuyển (Hiển thị)</option>
                <option value="closed" <%= job.status === 'closed' ? 'selected' : '' %>>Đóng tin tuyển dụng</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Hạn nộp hồ sơ <span class="text-danger">*</span></label>
            <input type="date" name="deadline" class="form-control" style="max-width: 250px;" value="<%= new Date(job.deadline).toISOString().split('T')[0] %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả công việc <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="5" required><%= job.description %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Yêu cầu ứng viên <span class="text-danger">*</span></label>
            <textarea name="requirements" class="form-control" rows="5" required><%= job.requirements %></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Quyền lợi & Chế độ đãi ngộ</label>
            <textarea name="benefits" class="form-control" rows="4"><%= job.benefits || '' %></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <a href="/recruiter/dashboard" class="btn btn-outline-secondary">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-floppy me-1"></i> Lưu Thay Đổi
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
