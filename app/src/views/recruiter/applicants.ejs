<%- include('../partials/header') %>

<div class="bg-primary text-white py-4 mb-4">
  <div class="container">
    <h1 class="h3 fw-bold mb-1">Danh Sách Hồ Sơ Ứng Tuyển</h1>
    <p class="mb-0 text-light opacity-90">Xem hồ sơ CV và xét duyệt ứng viên nộp vào các vị trí của công ty</p>
  </div>
</div>

<div class="container pb-5">
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <!-- Filter by Job -->
    <form action="/recruiter/applicants" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <label class="form-label small fw-semibold text-muted">Lọc theo vị trí tuyển dụng:</label>
        <select name="job_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Tất cả vị trí tuyển dụng --</option>
          <% jobs.forEach(j => { %>
            <option value="<%= j.id %>" <%= selectedJobId == j.id ? 'selected' : '' %>><%= j.title %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-7 text-md-end pt-md-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
          Tổng cộng: <%= applicants.length %> hồ sơ ứng tuyển
        </span>
      </div>
    </form>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <% if (applicants.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-people display-3 text-muted mb-3"></i>
        <h5>Chưa có ứng viên nào nộp hồ sơ</h5>
        <p class="text-muted">Các hồ sơ ứng tuyển mới sẽ tự động xuất hiện tại đây.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Ứng viên</th>
              <th scope="col">Vị trí nộp</th>
              <th scope="col">Kỹ năng / Kinh nghiệm</th>
              <th scope="col">Tệp CV</th>
              <th scope="col">Ngày nộp</th>
              <th scope="col" style="min-width: 180px;">Trạng thái & Cập nhật</th>
            </tr>
          </thead>
          <tbody>
            <% applicants.forEach(app => { %>
              <tr>
                <td>
                  <div class="fw-bold text-dark"><%= app.candidate_name %></div>
                  <div class="small text-muted"><i class="bi bi-envelope me-1"></i><%= app.candidate_email %></div>
                  <% if (app.candidate_phone) { %>
                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= app.candidate_phone %></div>
                  <% } %>
                </td>
                <td>
                  <a href="/jobs/<%= app.job_id %>" target="_blank" class="fw-semibold text-dark text-decoration-none hover-primary">
                    <%= app.job_title %>
                  </a>
                </td>
                <td class="small">
                  <% if (app.skills) { %>
                    <div class="text-dark"><i class="bi bi-code-slash text-primary me-1"></i><%= app.skills %></div>
                  <% } %>
                  <% if (app.experience) { %>
                    <div class="text-muted"><i class="bi bi-clock me-1"></i><%= app.experience %></div>
                  <% } %>
                </td>
                <td>
                  <a href="<%= app.cv_file %>" target="_blank" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Xem CV
                  </a>
                </td>
                <td class="text-muted small"><%= new Date(app.created_at).toLocaleDateString('vi-VN') %></td>
                <td>
                  <form action="/recruiter/application-status" method="POST" class="d-flex gap-1 align-items-center">
                    <input type="hidden" name="application_id" value="<%= app.id %>">
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                      <option value="submitted" <%= app.status === 'submitted' ? 'selected' : '' %>>Đã nộp</option>
                      <option value="reviewing" <%= app.status === 'reviewing' ? 'selected' : '' %>>Đang xét duyệt</option>
                      <option value="accepted" <%= app.status === 'accepted' ? 'selected' : '' %>>Mời phỏng vấn</option>
                      <option value="rejected" <%= app.status === 'rejected' ? 'selected' : '' %>>Từ chối</option>
                    </select>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
