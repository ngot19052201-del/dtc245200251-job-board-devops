<%- include('../partials/header') %>

<div class="bg-primary text-white py-4 mb-4">
  <div class="container">
    <h1 class="h3 fw-bold mb-1">Đăng Tin Tuyển Dụng Mới</h1>
    <p class="mb-0 text-light opacity-90">Điền thông tin chi tiết về vị trí tuyển dụng để tiếp cận ứng viên phù hợp</p>
  </div>
</div>

<div class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <form action="/recruiter/post-job" method="POST">
          
          <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề tin tuyển dụng <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" placeholder="Ví dụ: Kỹ sư DevOps (Docker, CI/CD, Kubernetes)" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Ngành nghề / Danh mục <span class="text-danger">*</span></label>
              <select name="category_id" class="form-select" required>
                <option value="" disabled selected>-- Chọn ngành nghề --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Hình thức làm việc <span class="text-danger">*</span></label>
              <select name="job_type" class="form-select" required>
                <option value="Toàn thời gian" selected>Toàn thời gian</option>
                <option value="Bán thời gian">Bán thời gian</option>
                <option value="Remote">Remote</option>
                <option value="Thực tập">Thực tập</option>
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Mức lương dự kiến <span class="text-danger">*</span></label>
              <input type="text" name="salary_range" class="form-control" placeholder="Ví dụ: 20 - 35 triệu VNĐ hoặc Thỏa thuận" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Địa điểm làm việc <span class="text-danger">*</span></label>
              <input type="text" name="location" class="form-control" placeholder="Ví dụ: Hà Nội / Thái Nguyên" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Hạn nộp hồ sơ <span class="text-danger">*</span></label>
            <input type="date" name="deadline" class="form-control" style="max-width: 250px;" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả công việc <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="5" placeholder="Chi tiết các nhiệm vụ, công việc hàng ngày..." required></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Yêu cầu ứng viên <span class="text-danger">*</span></label>
            <textarea name="requirements" class="form-control" rows="5" placeholder="Kỹ năng, kinh nghiệm, bằng cấp và chứng chỉ yêu cầu..." required></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Quyền lợi & Chế độ đãi ngộ</label>
            <textarea name="benefits" class="form-control" rows="4" placeholder="Thưởng dự án, bảo hiểm, đào tạo, du lịch hàng năm..."></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <a href="/recruiter/dashboard" class="btn btn-outline-secondary">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-send-check me-1"></i> Xuất Bản Tin Tuyển Dụng
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
