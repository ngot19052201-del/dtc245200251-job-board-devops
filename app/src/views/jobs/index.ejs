<%- include('../partials/header') %>

<div class="bg-primary text-white py-4 mb-4">
  <div class="container">
    <h1 class="h3 fw-bold mb-1">Khám Phá Việc Làm Công Nghệ</h1>
    <p class="mb-0 text-light opacity-90">Tìm kiếm vị trí phù hợp với năng lực và mục tiêu nghề nghiệp của bạn</p>
  </div>
</div>

<div class="container pb-5">
  <div class="row g-4">
    <!-- Filter Sidebar -->
    <div class="col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px; z-index: 10;">
        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <i class="bi bi-funnel text-primary"></i> Bộ Lọc Tìm Kiếm
        </h5>

        <form action="/jobs" method="GET">
          <!-- Keyword -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Từ khóa</label>
            <input type="text" name="keyword" value="<%= filters.keyword %>" class="form-control" placeholder="Tên việc làm, kỹ năng...">
          </div>

          <!-- Category -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Ngành nghề</label>
            <select name="category" class="form-select">
              <option value="all">Tất cả ngành nghề</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= filters.category == cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
          </div>

          <!-- Location -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Địa điểm</label>
            <input type="text" name="location" value="<%= filters.location %>" class="form-control" placeholder="Hà Nội, Thái Nguyên...">
          </div>

          <!-- Job Type -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Hình thức làm việc</label>
            <select name="job_type" class="form-select">
              <option value="all">Tất cả hình thức</option>
              <option value="Toàn thời gian" <%= filters.job_type === 'Toàn thời gian' ? 'selected' : '' %>>Toàn thời gian</option>
              <option value="Bán thời gian" <%= filters.job_type === 'Bán thời gian' ? 'selected' : '' %>>Bán thời gian</option>
              <option value="Remote" <%= filters.job_type === 'Remote' ? 'selected' : '' %>>Remote</option>
              <option value="Thực tập" <%= filters.job_type === 'Thực tập' ? 'selected' : '' %>>Thực tập</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bi bi-search me-1"></i> Áp Dụng Lọc
          </button>
          <a href="/jobs" class="btn btn-outline-secondary w-100 btn-sm">Đặt lại</a>
        </form>
      </div>
    </div>

    <!-- Job List -->
    <div class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted small">
          Tìm thấy <strong class="text-dark"><%= pagination.totalJobs %></strong> việc làm phù hợp
        </div>
      </div>

      <% if (jobs.length === 0) { %>
        <div class="card border-0 shadow-sm p-5 text-center">
          <i class="bi bi-search display-3 text-muted mb-3"></i>
          <h4>Không tìm thấy việc làm phù hợp</h4>
          <p class="text-muted">Vui lòng thử điều chỉnh lại bộ lọc hoặc từ khóa tìm kiếm.</p>
          <div>
            <a href="/jobs" class="btn btn-outline-primary">Xem tất cả việc làm</a>
          </div>
        </div>
      <% } else { %>
        <div class="d-flex flex-column gap-3">
          <% jobs.forEach(job => { %>
            <div class="card card-job p-4">
              <div class="d-flex gap-3 align-items-start">
                <div class="bg-primary-subtle text-primary rounded-3 p-3 text-center d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; min-width: 60px;">
                  <i class="bi bi-building fs-3"></i>
                </div>
                <div class="flex-grow-1">
                  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <h5 class="fw-bold mb-1">
                      <a href="/jobs/<%= job.id %>" class="text-decoration-none text-dark hover-primary"><%= job.title %></a>
                    </h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><%= job.job_type %></span>
                  </div>
                  <div class="text-muted small fw-medium mb-2"><%= job.company_name %></div>
                  
                  <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                    <span><i class="bi bi-cash-stack text-success me-1"></i><%= job.salary_range %></span>
                    <span><i class="bi bi-geo-alt text-danger me-1"></i><%= job.location %></span>
                    <span><i class="bi bi-clock-history text-primary me-1"></i>Hạn: <%= new Date(job.deadline).toLocaleDateString('vi-VN') %></span>
                  </div>

                  <p class="text-secondary small mb-3 text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= job.description %>
                  </p>

                  <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="badge bg-light text-dark border"><%= job.category_name %></span>
                    <a href="/jobs/<%= job.id %>" class="btn btn-sm btn-primary">
                      Ứng tuyển ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <nav class="mt-4">
            <ul class="pagination justify-content-center">
              <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
                  <a class="page-link" href="/jobs?page=<%= i %>&keyword=<%= encodeURIComponent(filters.keyword) %>&category=<%= filters.category %>&location=<%= encodeURIComponent(filters.location) %>&job_type=<%= filters.job_type %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
