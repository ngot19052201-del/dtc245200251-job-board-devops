<%- include('partials/header') %>

<!-- Hero Banner -->
<section class="hero-section">
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-8 mx-auto text-center">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fw-semibold">
          🚀 Nền Tảng Tuyển Dụng Công Nghệ Hàng Đầu 2026
        </span>
        <h1 class="display-4 fw-extrabold text-white mb-3">
          Khám Phá Cơ Hội Nghề Nghiệp <br><span class="text-info">IT & DevOps</span> Đỉnh Cao
        </h1>
        <p class="lead text-light opacity-90 mb-4">
          Kết nối hơn 10.000+ kỹ sư phần mềm, quản trị hệ thống và sinh viên tài năng với các tập đoàn công nghệ tiên phong tại Việt Nam.
        </p>

        <!-- Search Form -->
        <div class="search-box p-3 text-start">
          <form action="/jobs" method="GET" class="row g-2 align-items-center">
            <div class="col-md-5">
              <div class="input-group">
                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="keyword" class="form-control border-0 shadow-none ps-0" placeholder="Chức danh, kỹ năng (Docker, Node.js...)">
              </div>
            </div>
            <div class="col-md-3 border-start">
              <div class="input-group">
                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                <input type="text" name="location" class="form-control border-0 shadow-none ps-0" placeholder="Địa điểm (Hà Nội, Thái Nguyên...)">
              </div>
            </div>
            <div class="col-md-4">
              <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-search me-1"></i> Tìm Việc Làm Ngay
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-white border-bottom">
  <div class="container">
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-number"><%= stats.totalJobs %>+</div>
          <div class="text-muted fw-medium mt-1">Tin Tuyển Dụng Đang Mở</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-number text-success"><%= stats.totalCompanies %>+</div>
          <div class="text-muted fw-medium mt-1">Doanh Nghiệp Đối Tác Hàng Đầu</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-number text-info"><%= stats.totalApplications %>+</div>
          <div class="text-muted fw-medium mt-1">Hồ Sơ Đã Ứng Tuyển Thành Công</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Job Categories -->
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <div>
        <h2 class="fw-bold h3 mb-1">Ngành Nghề Tuyển Dụng Nổi Bật</h2>
        <p class="text-muted mb-0">Lựa chọn ngành nghề phù hợp với năng lực và định hướng tương lai của bạn</p>
      </div>
      <a href="/jobs" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-3">
      <% categories.forEach(category => { %>
        <div class="col-lg-4 col-md-6">
          <a href="/jobs?category=<%= category.id %>" class="card-category">
            <i class="bi <%= category.icon %>"></i>
            <h5 class="fw-bold mb-1"><%= category.name %></h5>
            <div class="text-muted small mb-2"><%= category.description %></div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-semibold">
              <%= category.job_count %> việc làm đang tuyển
            </span>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Recent Jobs -->
<section class="py-5 bg-white border-top border-bottom">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <div>
        <h2 class="fw-bold h3 mb-1">Việc Làm Mới Nhất</h2>
        <p class="text-muted mb-0">Cơ hội việc làm chất lượng cao từ các nhà tuyển dụng hàng đầu</p>
      </div>
      <a href="/jobs" class="btn btn-outline-primary btn-sm">Xem tất cả tin tuyển dụng <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-4">
      <% recentJobs.forEach(job => { %>
        <div class="col-lg-6">
          <div class="card card-job h-100 p-4">
            <div class="d-flex gap-3 align-items-start">
              <div class="bg-light rounded-3 p-2 text-center" style="width: 56px; height: 56px; min-width: 56px;">
                <i class="bi bi-building fs-3 text-primary"></i>
              </div>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                  <h5 class="fw-bold mb-1">
                    <a href="/jobs/<%= job.id %>" class="text-decoration-none text-dark hover-primary"><%= job.title %></a>
                  </h5>
                  <span class="badge bg-success-subtle text-success border border-success-subtle"><%= job.job_type %></span>
                </div>
                <div class="text-muted small fw-medium mb-2"><%= job.company_name %></div>
                
                <div class="d-flex flex-wrap gap-2 text-muted small mb-3">
                  <span><i class="bi bi-cash-stack text-success me-1"></i><%= job.salary_range %></span>
                  <span>&bull;</span>
                  <span><i class="bi bi-geo-alt text-danger me-1"></i><%= job.location %></span>
                  <span>&bull;</span>
                  <span><i class="bi bi-calendar-check text-primary me-1"></i>Hạn: <%= new Date(job.deadline).toLocaleDateString('vi-VN') %></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                  <span class="badge bg-light text-dark border"><%= job.category_name %></span>
                  <a href="/jobs/<%= job.id %>" class="btn btn-sm btn-outline-primary">
                    Chi tiết & Ứng tuyển <i class="bi bi-chevron-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Companies -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold h3 mb-2">Nhà Tuyển Dụng Hàng Đầu</h2>
      <p class="text-muted">Các doanh nghiệp công nghệ tiêu biểu đang tìm kiếm nhân tài</p>
    </div>

    <div class="row g-4 justify-content-center">
      <% companies.forEach(comp => { %>
        <div class="col-lg-3 col-md-6">
          <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100 bg-white">
            <div class="mx-auto bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
              <i class="bi bi-buildings-fill fs-2"></i>
            </div>
            <h5 class="fw-bold mb-1"><%= comp.name %></h5>
            <p class="text-muted small mb-3"><%= comp.address %></p>
            <span class="badge bg-light text-primary border mb-3"><%= comp.scale %></span>
            <div class="mt-auto">
              <a href="/jobs?keyword=<%= encodeURIComponent(comp.name) %>" class="btn btn-sm btn-outline-primary w-100">
                <%= comp.open_jobs %> việc làm đang tuyển
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Call to action -->
<section class="py-5 bg-primary text-white">
  <div class="container text-center py-3">
    <h2 class="display-6 fw-bold mb-3">Bạn Là Nhà Tuyển Dụng Muốn Tìm Ứng Viên Xuất Sắc?</h2>
    <p class="lead mb-4 opacity-90">Đăng tin tuyển dụng hoàn toàn miễn phí và tiếp cận hàng ngàn kỹ sư tài năng ngay hôm nay.</p>
    <a href="/auth/register" class="btn btn-light btn-lg text-primary fw-bold px-4 shadow">
      <i class="bi bi-megaphone-fill me-2"></i> Đăng Tin Tuyển Dụng Ngay
    </a>
  </div>
</section>

<%- include('partials/footer') %>
