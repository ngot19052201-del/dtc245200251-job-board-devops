<%- include('../partials/header') %>

<div class="bg-dark text-white py-4 mb-4">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h1 class="h3 fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i> Quản Lý Tài Khoản Người Dùng</h1>
      <p class="mb-0 text-secondary">Quản trị danh sách thành viên, phân quyền và khóa/mở tài khoản</p>
    </div>
    <div>
      <a href="/admin" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại Dashboard</a>
    </div>
  </div>
</div>

<div class="container pb-5">
  <!-- Filter -->
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <form action="/admin/users" method="GET" class="row g-3 align-items-center">
      <div class="col-md-4">
        <label class="form-label small fw-semibold text-muted">Lọc theo vai trò:</label>
        <select name="role" class="form-select" onchange="this.form.submit()">
          <option value="all" <%= filter.role === 'all' ? 'selected' : '' %>>Tất cả vai trò</option>
          <option value="candidate" <%= filter.role === 'candidate' ? 'selected' : '' %>>Ứng viên (Candidate)</option>
          <option value="recruiter" <%= filter.role === 'recruiter' ? 'selected' : '' %>>Nhà tuyển dụng (Recruiter)</option>
          <option value="admin" <%= filter.role === 'admin' ? 'selected' : '' %>>Quản trị viên (Admin)</option>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold text-muted">Lọc theo trạng thái:</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
          <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>Tất cả trạng thái</option>
          <option value="active" <%= filter.status === 'active' ? 'selected' : '' %>>Hoạt động (Active)</option>
          <option value="locked" <%= filter.status === 'locked' ? 'selected' : '' %>>Đang bị khóa (Locked)</option>
        </select>
      </div>
      <div class="col-md-4 text-md-end pt-md-4">
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
          Tổng số: <%= users.length %> tài khoản
        </span>
      </div>
    </form>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Họ và tên</th>
            <th scope="col">Email</th>
            <th scope="col">Số điện thoại</th>
            <th scope="col">Vai trò</th>
            <th scope="col" class="text-center">Trạng thái</th>
            <th scope="col">Ngày tạo</th>
            <th scope="col" class="text-end">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td class="text-muted fw-bold">#<%= u.id %></td>
              <td class="fw-semibold text-dark"><%= u.full_name %></td>
              <td><%= u.email %></td>
              <td class="text-muted"><%= u.phone || '-' %></td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="badge bg-danger text-white">ADMIN</span>
                <% } else if (u.role === 'recruiter') { %>
                  <span class="badge bg-primary text-white">RECRUITER</span>
                <% } else { %>
                  <span class="badge bg-success text-white">CANDIDATE</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (u.status === 'active') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Hoạt động</span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Đã khóa</span>
                <% } %>
              </td>
              <td class="text-muted small"><%= new Date(u.created_at).toLocaleDateString('vi-VN') %></td>
              <td class="text-end">
                <% if (u.id !== user.id) { %>
                  <form action="/admin/users/toggle-status" method="POST" class="d-inline">
                    <input type="hidden" name="user_id" value="<%= u.id %>">
                    <input type="hidden" name="current_status" value="<%= u.status %>">
                    <% if (u.status === 'active') { %>
                      <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này?')">
                        <i class="bi bi-lock me-1"></i> Khóa
                      </button>
                    <% } else { %>
                      <button type="submit" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-unlock me-1"></i> Mở khóa
                      </button>
                    <% } %>
                  </form>
                <% } else { %>
                  <span class="text-muted small italic">Tài khoản của bạn</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
