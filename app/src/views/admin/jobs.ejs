<%- include('../partials/header') %>

<div class="bg-dark text-white py-4 mb-4">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h1 class="h3 fw-bold mb-1"><i class="bi bi-briefcase-fill text-warning me-2"></i> Kiểm Duyệt & Quản Lý Tin Tuyển Dụng</h1>
      <p class="mb-0 text-secondary">Kiểm tra nội dung tin đăng từ các doanh nghiệp trước khi cho phép hiển thị công khai</p>
    </div>
    <div>
      <a href="/admin" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại Dashboard</a>
    </div>
  </div>
</div>

<div class="container pb-5">
  <!-- Filter -->
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <form action="/admin/jobs" method="GET" class="row g-3 align-items-center">
      <div class="col-md-5">
        <label class="form-label small fw-semibold text-muted">Lọc theo trạng thái tin:</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
          <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>Tất cả trạng thái</option>
          <option value="pending" <%= filter.status === 'pending' ? 'selected' : '' %>>Chờ duyệt (Pending)</option>
          <option value="approved" <%= filter.status === 'approved' ? 'selected' : '' %>>Đã duyệt / Hiển thị (Approved)</option>
          <option value="rejected" <%= filter.status === 'rejected' ? 'selected' : '' %>>Bị từ chối (Rejected)</option>
          <option value="closed" <%= filter.status === 'closed' ? 'selected' : '' %>>Đã đóng tuyển (Closed)</option>
        </select>
      </div>
      <div class="col-md-7 text-md-end pt-md-4">
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
          Tổng số: <%= jobs.length %> tin tuyển dụng
        </span>
      </div>
    </form>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Tiêu đề tin</th>
            <th scope="col">Doanh nghiệp</th>
            <th scope="col">Ngành nghề</th>
            <th scope="col">Hạn nộp</th>
            <th scope="col" class="text-center">Trạng thái</th>
            <th scope="col" class="text-end">Xử lý / Duyệt tin</th>
          </tr>
        </thead>
        <tbody>
          <% jobs.forEach(job => { %>
            <tr>
              <td class="text-muted fw-bold">#<%= job.id %></td>
              <td>
                <a href="/jobs/<%= job.id %>" target="_blank" class="fw-semibold text-dark text-decoration-none hover-primary">
                  <%= job.title %>
                </a>
                <div class="small text-muted"><%= job.location %> &bull; <%= job.salary_range %></div>
              </td>
              <td class="fw-medium"><%= job.company_name %></td>
              <td><span class="badge bg-light text-dark border"><%= job.category_name %></span></td>
              <td class="text-muted small"><%= new Date(job.deadline).toLocaleDateString('vi-VN') %></td>
              <td class="text-center">
                <% if (job.status === 'approved') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                <% } else if (job.status === 'pending') { %>
                  <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                <% } else if (job.status === 'closed') { %>
                  <span class="badge bg-secondary-subtle text-secondary border">Closed</span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger border">Rejected</span>
                <% } %>
              </td>
              <td class="text-end">
                <form action="/admin/jobs/approve" method="POST" class="d-inline-flex gap-1 justify-content-end">
                  <input type="hidden" name="job_id" value="<%= job.id %>">
                  <% if (job.status !== 'approved') { %>
                    <button type="submit" name="action" value="approved" class="btn btn-sm btn-outline-success" title="Duyệt cho phép hiển thị">
                      <i class="bi bi-check-lg"></i> Duyệt
                    </button>
                  <% } %>
                  <% if (job.status !== 'rejected') { %>
                    <button type="submit" name="action" value="rejected" class="btn btn-sm btn-outline-danger" title="Từ chối tin">
                      <i class="bi bi-x-lg"></i> Từ chối
                    </button>
                  <% } %>
                  <% if (job.status === 'approved') { %>
                    <button type="submit" name="action" value="closed" class="btn btn-sm btn-outline-secondary" title="Đóng tin">
                      <i class="bi bi-lock"></i> Đóng tin
                    </button>
                  <% } %>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
